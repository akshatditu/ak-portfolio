# Copy to `.env.local` and fill in. OPTIONAL — the site builds and runs
# correctly without it.

# Canonical origin. Used for metadataBase, sitemap and OG image URLs.
#
# Production already defaults to https://www.akshatguptadev.in (see
# PRODUCTION_URL in src/config/site.ts), and `next dev` defaults to localhost.
# Only set this to point a build somewhere else, e.g. a staging host.
# NEXT_PUBLIC_SITE_URL="https://staging.example.com"
